# ---------- Core ----------
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (database name in the path)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/privatechat?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-random-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MEDIA_SIGNING_SECRET=replace-with-another-64-random-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins (web app URLs)
CLIENT_ORIGINS=http://localhost:5173
# Public URL of this API (used to build absolute media URLs)
PUBLIC_API_URL=http://localhost:4000
# Web app URL (used in password reset emails)
WEB_APP_URL=http://localhost:5173
# Number of reverse proxies in front of the app (Render = 1)
TRUST_PROXY=1

# ---------- Media storage ----------
# local = files on disk (development only) | cloudinary = production
STORAGE_DRIVER=local
MAX_UPLOAD_MB=25
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (password reset) ----------
# Brevo (https://app.brevo.com → SMTP & API → API keys). If BREVO_API_KEY is empty, reset links are printed to the server log (development only).
BREVO_API_KEY=
# Must be a sender you verified in Brevo
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="M32 Baddies"

# ---------- WebRTC ----------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Comma-separated TURN URLs, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
# Option A: static TURN credentials (managed providers such as Metered, Twilio, Xirsys)
TURN_USERNAME=
TURN_CREDENTIAL=
# Option B: coturn "use-auth-secret" shared secret -> short-lived credentials are generated
TURN_SECRET=
# Cloudflare Realtime TURN (overrides the TURN_* settings above when both are set)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_TTL_SECONDS=3600

# ---------- Push notifications ----------
# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional Expo access token (only if "enhanced push security" is enabled in your Expo account)
EXPO_ACCESS_TOKEN=

# Usernames that can open the admin panel (comma-separated). Admins are approved automatically on sign-up.
ADMIN_USERNAMES=
